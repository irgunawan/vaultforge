<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VaultForge</AssemblyName>
    <RootNamespace>VaultForge</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.8</Version>
    <FileVersion>1.0.8.0</FileVersion>
    <AssemblyVersion>1.0.8.0</AssemblyVersion>
    <Product>VaultForge</Product>
    <Company>irgun.web.id</Company>
    <Description>Modern lightweight GUI for the Hermes vault (PowerShell bridge).</Description>
    <Copyright>© 2026 Iriyan Gunawan</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="setup/**" />
    <EmbeddedResource Remove="setup/**" />
    <None Remove="setup/**" />
    <None Update="vaultforge_bridge.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vaultforge_helper.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="Never" />
    <EmbeddedResource Include="vaultforge_bridge.ps1">
      <LogicalName>VaultForge.vaultforge_bridge.ps1</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="vaultforge_helper.py">
      <LogicalName>VaultForge.vaultforge_helper.py</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
