<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="VaultForge" Language="1033" Version="1.0.5"
           Manufacturer="irgun.web.id" UpgradeCode="799C6EB4-A5CE-4318-8FBF-3E484755952E">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"/>
    <MajorUpgrade DowngradeErrorMessage="Versi VaultForge yang lebih baru sudah terpasang."/>
    <Media Id="1" Cabinet="product.cab" EmbedCab="yes"/>

    <Icon Id="AppIcon" SourceFile="app.ico"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon"/>
    <Property Id="ARPHELPLINK" Value="https://github.com/irgunawan/vaultforge"/>
    <Property Id="ARPNOREPAIR" Value="1"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="VaultForge">
          <Component Id="MainExe" Guid="{C7363C68-6E2D-412F-9D32-B4CB682F129B}" Win64="no">
            <File Id="MainExeFile" Source="publish/VaultForge.exe" KeyPath="yes">
              <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuDir" Name="VaultForge" WorkingDirectory="INSTALLDIR" Icon="AppIcon" Advertise="yes"/>
              <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="VaultForge" WorkingDirectory="INSTALLDIR" Icon="AppIcon" Advertise="yes"/>
            </File>
          </Component>
          <Component Id="ConfigFile" Guid="{03A9633C-B3DE-48BC-B692-40BD8D5B0BC3}" Win64="no">
            <File Id="ConfigFileFile" Source="publish/VaultForge.exe.config" KeyPath="yes"/>
          </Component>
          <Component Id="BridgeScript" Guid="{D9D27C1D-20D0-438D-B5DE-F055717C1A22}" Win64="no">
            <File Id="BridgeScriptFile" Source="publish/vaultforge_bridge.ps1" KeyPath="yes"/>
          </Component>
          <Component Id="HelperScript" Guid="{0438274B-26EC-4533-9803-975695362901}" Win64="no">
            <File Id="HelperScriptFile" Source="publish/vaultforge_helper.py" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="VaultForge"/>
      </Directory>
      <Directory Id="DesktopFolder"/>
    </Directory>

    <Feature Id="MainFeature" Title="VaultForge" Level="1">
      <ComponentRef Id="MainExe"/>
      <ComponentRef Id="ConfigFile"/>
      <ComponentRef Id="BridgeScript"/>
      <ComponentRef Id="HelperScript"/>
    </Feature>
  </Product>
</Wix>
